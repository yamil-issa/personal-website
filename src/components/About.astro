---
import { getDict } from "../i18n/utils";
const t = getDict();
---

<section id="about" class="about">
  <div class="wrap">
    <p class="eyebrow"><span>{t.about.fileLabel}</span> <span class="dim">// {t.about.eyebrow}</span></p>

    <div class="about-grid">
      <p class="lead">{t.about.lead}</p>

      <div class="about-body">
        {t.about.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 120px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .lead {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.4;
    max-width: 26ch;
  }

  .about-body p {
    color: var(--muted);
    max-width: 58ch;
    margin-bottom: 18px;
  }

  .about-body p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 64px;
    }
  }
</style>
