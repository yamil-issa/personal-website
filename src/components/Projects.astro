---
import { getDict } from "../i18n/utils";
const t = getDict();
const projects = t.projects.items;
---

<section id="work" class="work">
  <div class="wrap">
    <p class="eyebrow"><span>{t.projects.fileLabel}</span> <span class="dim">// {t.projects.eyebrow}</span></p>

    <div class="projects">
      {projects.map((p) => (
        <article class:list={['project', { empty: !p.href }]}>
          <span class="project-id">{p.id}</span>

          <div class="project-body">
            <div class="project-head">
              <h3 class="project-name">
                {p.href ? (
                  <a href={p.href} target={p.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="glitch" data-text={p.name}>
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <span class="project-status">{p.status}</span>
            </div>

            <p class="project-desc">{p.description}</p>

            {p.tags.length > 0 && (
              <ul class="project-tags">
                {p.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding: 100px 0;
  }

  .projects {
    border-top: 1px solid var(--border);
  }

  .project {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    padding: 40px 0;
    border-bottom: 1px solid var(--border);
  }

  .project.empty {
    opacity: 0.45;
  }

  .project-id {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-2);
    padding-top: 4px;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 500;
  }

  .project-name a:hover {
    color: var(--accent);
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .project-desc {
    color: var(--muted);
    max-width: 60ch;
    margin-top: 14px;
  }

  .project-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }

  .project-tags li::before {
    content: '#';
    color: var(--muted-2);
    margin-right: 2px;
  }
</style>
