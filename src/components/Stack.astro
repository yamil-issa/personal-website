---
import { getDict } from "../i18n/utils";
const t = getDict();
const groups = t.stack.groups;
---

<section id="stack" class="stack">
  <div class="wrap">
    <p class="eyebrow"><span>{t.stack.fileLabel}</span> <span class="dim">// {t.stack.eyebrow}</span></p>

    <div class="spec">
      {groups.map((group) => (
        <div class="spec-row">
          <span class="spec-label">{group.label}</span>
          <ul class="spec-items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack {
    padding: 100px 0;
  }

  .spec {
    border-top: 1px solid var(--border);
  }

  .spec-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .spec-items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    color: var(--white);
  }

  .spec-items li {
    position: relative;
    padding-left: 14px;
  }

  .spec-items li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
